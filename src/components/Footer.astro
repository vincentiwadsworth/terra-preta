---
import { site } from "../data/site";

const currentYear = new Date().getFullYear();

const footerLinks = [
  { label: "Home", href: "#hero" },
  { label: "Origin", href: "#origin" },
  { label: "Certifications", href: "#certifications" },
  { label: "Product", href: "#product" },
  { label: "Export", href: "#export" },
  { label: "Contact", href: "#contact" },
];
---

<footer
  role="contentinfo"
  class="bg-earth-brown text-cream/90"
>
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-3">
      <!-- Col 1: Brand -->
      <div>
        <p class="text-lg font-semibold text-cream">{site.companyName}</p>
        <p class="mt-2 text-sm leading-relaxed text-cream/70 text-balance">
          {site.tagline}
        </p>
      </div>

      <!-- Col 2: Quick Links -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-cream">
          Quick Links
        </h3>
        <nav aria-label="Footer navigation">
          <ul class="mt-4 space-y-2">
            {footerLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-cream/70 transition-colors hover:text-cream focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent rounded"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <!-- Col 3: Contact -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-cream">
          Contact
        </h3>
        <ul class="mt-4 space-y-2 text-sm text-cream/70">
          <li class="flex items-start gap-2">
            <span aria-hidden="true" class="mt-0.5 shrink-0">📱</span>
            <span>WhatsApp: {site.whatsappNumber}</span>
          </li>
          <li class="flex items-start gap-2">
            <span aria-hidden="true" class="mt-0.5 shrink-0">✉️</span>
            <span>{site.contactEmail}</span>
          </li>
          <li class="flex items-start gap-2">
            <span aria-hidden="true" class="mt-0.5 shrink-0">📍</span>
            <span>Beni, Bolivia</span>
          </li>
        </ul>

        <!-- Social links -->
        <div class="mt-6 flex gap-4">
          {site.socialLinks.linkedin && (
            <a
              href={site.socialLinks.linkedin}
              rel="noopener noreferrer"
              target="_blank"
              class="inline-flex items-center justify-center rounded-md border border-cream/20 p-2 text-cream/70 transition-colors hover:bg-cream/10 hover:text-cream focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent min-h-[44px] min-w-[44px]"
              aria-label="LinkedIn"
            >
              <svg aria-hidden="true" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </a>
          )}
          {site.socialLinks.instagram && (
            <a
              href={site.socialLinks.instagram}
              rel="noopener noreferrer"
              target="_blank"
              class="inline-flex items-center justify-center rounded-md border border-cream/20 p-2 text-cream/70 transition-colors hover:bg-cream/10 hover:text-cream focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent min-h-[44px] min-w-[44px]"
              aria-label="Instagram"
            >
              <svg aria-hidden="true" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>
          )}
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 border-t border-cream/10 pt-8 text-center">
      <p class="text-xs text-cream/50">
        &copy; {currentYear} {site.companyName}. All rights reserved.
        &mdash; USDA NOP and EU Organic Certified.
      </p>
    </div>
  </div>
</footer>
