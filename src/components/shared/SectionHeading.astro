---
export interface Props {
  title: string;
  subtitle?: string;
  id?: string;
}

const { title, subtitle, id } = Astro.props;
---

<div class:list={["text-center", subtitle ? "mb-12" : "mb-8"]}>
  <h2
    id={id}
    class="text-3xl md:text-4xl font-bold text-on-background text-balance"
  >
    {title}
  </h2>
  {
    subtitle && (
      <p class="mt-3 text-lg text-muted text-balance max-w-2xl mx-auto">
        {subtitle}
      </p>
    )
  }
</div>
