---
export interface Props {
  title: string;
  subtitle?: string;
  id?: string;
  inverted?: boolean;
}

const { title, subtitle, id, inverted = false } = Astro.props;
---

<div class:list={["text-center", subtitle ? "mb-12" : "mb-8"]}>
  <h2
    id={id}
    class:list={[
      "text-3xl md:text-4xl font-bold text-balance",
      inverted ? "text-cream" : "text-on-background",
    ]}
  >
    {title}
  </h2>
  {
    subtitle && (
      <p
        class:list={[
          "mt-3 text-lg text-balance max-w-2xl mx-auto",
          inverted ? "text-cream/80" : "text-muted",
        ]}
      >
        {subtitle}
      </p>
    )
  }
</div>
