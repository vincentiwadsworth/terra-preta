---
export interface Props {
  href: string;
  variant?: "primary" | "secondary" | "outline" | "outline-light";
  size?: "default" | "lg";
  external?: boolean;
}

const {
  href,
  variant = "primary",
  size = "default",
  external = false,
} = Astro.props;

const baseClasses =
  "inline-flex items-center justify-center font-medium rounded-md transform-gpu focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent min-h-[44px] min-w-[44px]";

const variantClasses: Record<string, string> = {
  primary:
    "bg-forest-green text-cream hover:bg-forest-green/90 shadow-md hover:-translate-y-0.5 hover:shadow-lg active:scale-[0.97]",
  secondary:
    "bg-acai-purple text-cream hover:bg-acai-purple/90 shadow-md hover:-translate-y-0.5 hover:shadow-lg active:scale-[0.97]",
  outline:
    "border-2 border-forest-green text-forest-green bg-transparent hover:bg-forest-green hover:text-cream hover:-translate-y-0.5 hover:shadow-lg active:scale-[0.97]",
  "outline-light":
    "border-2 border-cream text-cream bg-transparent hover:bg-cream/10 hover:-translate-y-0.5 hover:shadow-lg active:scale-[0.97]",
};

const sizeClasses: Record<string, string> = {
  default: "px-5 py-2.5 text-sm",
  lg: "px-8 py-3.5 text-base",
};

const classList = [baseClasses, variantClasses[variant], sizeClasses[size]].join(" ");
---

<a
  href={href}
  class={classList}
  style="transition: transform 0.2s var(--ease-spring), box-shadow 0.2s ease, background-color 0.15s ease, color 0.15s ease;"
  rel={external ? "noopener noreferrer" : undefined}
  target={external ? "_blank" : undefined}
>
  <slot />
</a>
