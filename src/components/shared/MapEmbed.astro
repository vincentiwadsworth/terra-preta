---
import "leaflet/dist/leaflet.css";
---

<div
  id="sourcing-map"
  class="w-full aspect-[4/3] rounded-lg overflow-hidden border border-forest-green/10"
  aria-label="Map showing sourcing region: Riberalta, Beni, Bolivia"
  role="img"
>
  <!-- Leaflet mounts here -->
</div>

<script>
  import L from "leaflet";

  // Prevent 404s on default marker icons — we use a custom divIcon instead
  delete L.Icon.Default.prototype._getIconUrl;
  L.Icon.Default.mergeOptions({
    iconRetinaUrl: "",
    iconUrl: "",
    shadowUrl: "",
  });

  const riberaltaCoords = [-11.0, -66.1];

  const map = L.map("sourcing-map", {
    center: riberaltaCoords,
    zoom: 12,
    scrollWheelZoom: false,
    zoomControl: true,
    attributionControl: true,
  });

  L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
    attribution:
      '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    maxZoom: 19,
  }).addTo(map);

  const markerIcon = L.divIcon({
    className: "sourcing-marker",
    html: '<div class="sourcing-marker-inner"></div>',
    iconSize: [20, 20],
    iconAnchor: [10, 10],
    popupAnchor: [0, -12],
  });

  L.marker(riberaltaCoords, { icon: markerIcon })
    .addTo(map)
    .bindPopup(
      "<strong>Riberalta, Beni</strong><br>Bolivian Amazon<br><small>Comunidad Buen Retiro &middot; Luz de América &middot; El Porvenir</small>"
    )
    .openPopup();

  // Invalidate size after render (handles SSR hydration and tab-switch scenarios)
  setTimeout(() => map.invalidateSize(), 120);
</script>

<style>
  #sourcing-map {
    z-index: 0;
  }

  /* Custom marker: acai-purple pulse */
  .sourcing-marker {
    background: transparent !important;
    border: none !important;
  }

  .sourcing-marker-inner {
    width: 20px;
    height: 20px;
    background: #5B2C8E;
    border-radius: 50%;
    border: 3px solid white;
    box-shadow: 0 2px 8px rgba(91, 44, 142, 0.4);
    animation: marker-pulse 2s ease-in-out infinite;
  }

  @keyframes marker-pulse {
    0%, 100% {
      box-shadow: 0 2px 8px rgba(91, 44, 142, 0.4);
    }
    50% {
      box-shadow: 0 2px 16px rgba(91, 44, 142, 0.7);
    }
  }

  /* Suppress Leaflet default icon image references */
  .leaflet-default-icon-path {
    background-image: none !important;
  }
</style>
