---
import SectionHeading from "../shared/SectionHeading.astro";
import Button from "../shared/Button.astro";
import { site } from "../../data/site";
---

<section id="contact" class="section-padding bg-sand">
  <div class="container-narrow mx-auto">
    <SectionHeading
      title="Let's Talk Açaí"
      subtitle="Inquire about seasonal stock, request samples, or discuss your requirements."
    />

    <div class="mt-12 grid gap-12 lg:grid-cols-2">
      <!-- Left: Contact Form -->
      <div>
        <form
          action="https://formspree.io/f/xabcdefg"
          method="POST"
          class="space-y-6"
        >
          <div>
            <label for="name" class="mb-2 block text-sm font-medium text-earth-brown">
              Name <span aria-hidden="true">*</span>
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              autocomplete="name"
              class="w-full rounded-lg border border-sand bg-cream px-4 py-3 text-earth-brown placeholder:text-earth-brown/50 focus:border-acai-purple focus:outline-none focus:ring-2 focus:ring-acai-purple/30"
              placeholder="Your full name"
            />
          </div>

          <div>
            <label for="email" class="mb-2 block text-sm font-medium text-earth-brown">
              Email <span aria-hidden="true">*</span>
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              class="w-full rounded-lg border border-sand bg-cream px-4 py-3 text-earth-brown placeholder:text-earth-brown/50 focus:border-acai-purple focus:outline-none focus:ring-2 focus:ring-acai-purple/30"
              placeholder="you@company.com"
            />
          </div>

          <div>
            <label for="company" class="mb-2 block text-sm font-medium text-earth-brown">
              Company
            </label>
            <input
              type="text"
              id="company"
              name="company"
              autocomplete="organization"
              class="w-full rounded-lg border border-sand bg-cream px-4 py-3 text-earth-brown placeholder:text-earth-brown/50 focus:border-acai-purple focus:outline-none focus:ring-2 focus:ring-acai-purple/30"
              placeholder="Your company name"
            />
          </div>

          <div>
            <label for="message" class="mb-2 block text-sm font-medium text-earth-brown">
              Message <span aria-hidden="true">*</span>
            </label>
            <textarea
              id="message"
              name="message"
              required
              rows="5"
              class="w-full rounded-lg border border-sand bg-cream px-4 py-3 text-earth-brown placeholder:text-earth-brown/50 focus:border-acai-purple focus:outline-none focus:ring-2 focus:ring-acai-purple/30"
              placeholder="Tell us about your interest in açaí powder..."
            ></textarea>
          </div>

          <div>
            <Button href="#" variant="primary" size="lg">
              Send Inquiry
            </Button>
          </div>

          <noscript>
            <p class="text-sm text-earth-brown/70">
              JavaScript is not required. The form will open in a new page.
            </p>
          </noscript>
        </form>
      </div>

      <!-- Right: Direct Contact -->
      <div class="space-y-8 lg:pl-8">
        <div class="rounded-xl border border-sand/60 bg-cream p-6">
          <h3 class="mb-4 font-semibold text-forest-green text-lg">Prefer a direct conversation?</h3>

          <div class="space-y-4">
            <a
              href={`https://wa.me/${site.whatsappNumber.replace(/\+/g, "")}`}
              class="flex items-center gap-3 rounded-lg bg-[#25D366] px-5 py-3 text-white transition-colors hover:bg-[#1fb855] focus-visible:outline-2 focus-visible:outline-acai-purple"
              aria-label="Chat with us on WhatsApp"
            >
              <span class="text-2xl" aria-hidden="true">📱</span>
              <span class="font-medium">Chat on WhatsApp</span>
            </a>

            <a
              href={`mailto:${site.contactEmail}`}
              class="flex items-center gap-3 rounded-lg border border-sand bg-white px-5 py-3 text-earth-brown transition-colors hover:border-forest-green hover:bg-cream focus-visible:outline-2 focus-visible:outline-acai-purple"
              aria-label="Send us an email"
            >
              <span class="text-2xl" aria-hidden="true">✉️</span>
              <span class="font-medium">{site.contactEmail}</span>
            </a>

            <div class="flex items-center gap-3 rounded-lg border border-sand bg-white px-5 py-3 text-earth-brown">
              <span class="text-2xl" aria-hidden="true">📍</span>
              <span>Santa Cruz de la Sierra, Bolivia</span>
            </div>
          </div>

          <p class="mt-4 text-sm text-earth-brown/70">
            We typically respond within 24 hours.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
