---
import type { Translations } from "../i18n/ui";
import { Icon } from "astro-icon/components";
import SectionHeading from "../shared/SectionHeading.astro";
import Button from "../shared/Button.astro";
import { site } from "../../data/site";

export interface Props {
  locale: string;
  t: Translations;
}
const { locale, t } = Astro.props;
---

<section id="contact" class="section-padding bg-sand scroll-reveal">
  <div class="container-narrow mx-auto">
    <SectionHeading
      title={t["contact"]["heading"]}
      subtitle={t["contact"]["subheading"]}
    />

    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3 max-w-4xl mx-auto">
      <!-- WhatsApp -->
      <a
        href={`https://wa.me/${site.whatsappNumber.replace(/\+/g, "")}`}
        onclick="umami.track('cta-whatsapp')"
        class="group flex flex-col items-center gap-4 rounded-xl border border-sand/60 bg-cream p-8 text-center transition-shadow hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        aria-label={t["contact"]["whatsappAriaLabel"]}
      >
        <div class="w-14 h-14 flex items-center justify-center rounded-full bg-[#25D366]/10 text-[#25D366] group-hover:bg-[#25D366]/20 transition-colors">
          <Icon name="material-symbols:call" class="w-7 h-7" aria-hidden="true" />
        </div>
        <div>
          <p class="font-semibold text-on-background">{t["contact"]["whatsapp"]}</p>
          <p class="mt-1 text-sm text-on-background/70">{t["contact"]["contactName"]}</p>
          <p class="text-sm text-on-background/60 tabular-nums">+591 7164 1050</p>
        </div>
      </a>

      <!-- Email -->
      <a
        href={`mailto:${site.contactEmail}`}
        onclick="umami.track('cta-email')"
        class="group flex flex-col items-center gap-4 rounded-xl border border-sand/60 bg-cream p-8 text-center transition-shadow hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        aria-label={t["contact"]["emailAriaLabel"]}
      >
        <div class="w-14 h-14 flex items-center justify-center rounded-full bg-acai-purple/10 text-acai-purple group-hover:bg-acai-purple/20 transition-colors">
          <Icon name="material-symbols:mail" class="w-7 h-7" aria-hidden="true" />
        </div>
        <div>
          <p class="font-semibold text-on-background">{t["contact"]["email"]}</p>
          <p class="mt-1 text-sm text-on-background/70">{site.contactEmail}</p>
        </div>
      </a>

      <!-- Location -->
      <div
        class="flex flex-col items-center gap-4 rounded-xl border border-sand/60 bg-cream p-8 text-center"
      >
        <div class="w-14 h-14 flex items-center justify-center rounded-full bg-forest-green/10 text-forest-green">
          <Icon name="material-symbols:location-on" class="w-7 h-7" aria-hidden="true" />
        </div>
        <div>
          <p class="font-semibold text-on-background">{t["contact"]["location"]}</p>
          <p class="mt-1 text-sm text-on-background/70">{t["contact"]["locationCity"]}</p>
          <p class="text-sm text-on-background/60">{t["contact"]["locationCountry"]}</p>
        </div>
      </div>
    </div>

    <!-- Response time + downloadable docs -->
    <div class="mt-10 text-center space-y-4">
      <p class="text-sm text-on-background/60">
        {t["contact"]["responseTime"]}
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center items-center">
        <a
          href="/FT%20FREEZE%20DRIED%20ORGANIC%20ACAI%20POWDER.pdf"
          onclick="umami.track('download-datasheet')"
          class="inline-flex items-center gap-2 rounded-lg border border-forest-green/20 bg-cream px-5 py-2.5 text-sm font-medium text-forest-green transition-colors hover:bg-forest-green hover:text-cream focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent min-h-[44px]"
        >
          <Icon name="material-symbols:download" class="w-5 h-5" aria-hidden="true" />
          {t["contact"]["downloadDatasheet"]}
        </a>
        <a
          href="/Certificate_NOP_4080209399.pdf"
          onclick="umami.track('download-certificate')"
          class="inline-flex items-center gap-2 rounded-lg border border-acai-purple/20 bg-cream px-5 py-2.5 text-sm font-medium text-acai-purple transition-colors hover:bg-acai-purple hover:text-cream focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent min-h-[44px]"
        >
          <Icon name="material-symbols:verified" class="w-5 h-5" aria-hidden="true" />
          {t["contact"]["downloadCertificate"]}
        </a>
      </div>
    </div>
  </div>
</section>
