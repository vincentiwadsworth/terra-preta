---
import type { Translations } from "../i18n/ui";
import { Icon } from "astro-icon/components";
import Button from "../shared/Button.astro";

export interface Props {
  locale: string;
  t: Translations;
}
const { locale, t } = Astro.props;
---

<section
  id="hero"
  class="relative min-h-dvh flex items-center justify-center overflow-hidden"
>
  <!-- Background image — responsive WebP with srcset for LCP optimization -->
  <picture>
    <source
      srcset="https://images.unsplash.com/photo-1518531933037-91b2f5f229cc?w=800&q=80&fm=webp&fit=crop"
      media="(max-width: 767px)"
    />
    <source
      srcset="https://images.unsplash.com/photo-1518531933037-91b2f5f229cc?w=1440&q=80&fm=webp&fit=crop"
      media="(max-width: 1439px)"
    />
    <img
      src="https://images.unsplash.com/photo-1518531933037-91b2f5f229cc?w=1920&q=80&fm=webp&fit=crop"
      alt={t["hero"]["backgroundAlt"]}
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
      decoding="async"
      fetchpriority="high"
      width="1920"
      height="1280"
    />
  </picture>

  <!-- Dark overlay gradient: forest-green → transparent → earth-brown -->
  <div
    class="absolute inset-0 bg-gradient-to-b from-forest-green/80 via-forest-green/35 to-earth-brown/70"
    aria-hidden="true"
  ></div>

  <!-- Content -->
  <div class="relative z-10 text-center px-4 max-w-4xl mx-auto py-20 scroll-reveal">
    <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold text-cream text-balance leading-tight">
      <Fragment set:html={t["hero"]["title"]} />
    </h1>
    <p class="mt-6 text-lg md:text-xl text-cream text-balance max-w-3xl mx-auto leading-relaxed">
      {t["hero"]["subtitle"]}
    </p>
    <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center items-center">
      <Button href="#contact" variant="primary" size="lg" umamiEvent="cta-inquire">
        {t["hero"]["ctaPrimary"]}
      </Button>
      <Button href="/FT%20FREEZE%20DRIED%20ORGANIC%20ACAI%20POWDER.pdf" variant="outline-light" size="lg" external umamiEvent="download-product-specs">
        {t["hero"]["ctaSecondary"]}
      </Button>
    </div>
  </div>

  <!-- Scroll-down indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10">
    <a
      href="#how-we-work"
      class="flex flex-col items-center gap-2 text-cream hover:text-cream/80 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent rounded"
      aria-label={t["hero"]["scrollAriaLabel"]}
    >
      <span class="text-xs uppercase tracking-widest">{t["hero"]["scrollHint"]}</span>
      <span class="animate-bounce" aria-hidden="true">
        <Icon name="material-symbols:arrow-downward" class="w-6 h-6" />
      </span>
    </a>
  </div>
</section>
