---
import { Icon } from "astro-icon/components";
import Button from "../shared/Button.astro";

const heroBg =
  "https://images.unsplash.com/photo-1518531933037-91b2f5f229cc?w=1920&q=80";
---

<section
  id="hero"
  class="relative min-h-dvh flex items-center justify-center overflow-hidden"
>
  <!-- Background image -->
  <img
    src={heroBg}
    alt="Aerial view of the Amazon rainforest river — lush green canopy winding through the landscape"
    class="absolute inset-0 w-full h-full object-cover"
    loading="eager"
    decoding="async"
    fetchpriority="high"
  />

  <!-- Dark overlay gradient: forest-green → transparent → earth-brown -->
  <div
    class="absolute inset-0 bg-gradient-to-b from-forest-green/75 via-forest-green/30 to-earth-brown/65"
    aria-hidden="true"
  ></div>

  <!-- Content -->
  <div class="relative z-10 text-center px-4 max-w-4xl mx-auto py-20">
    <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold text-cream text-balance leading-tight">
      Amazonian Açaí,<br class="sm:hidden" /> European Standards
    </h1>
    <p class="mt-6 text-lg md:text-xl text-cream/90 text-balance max-w-3xl mx-auto leading-relaxed">
      Premium freeze-dried açaí powder from the Bolivian Amazon. USDA NOP and
      EU Organic certified. Direct from producer to your facility.
    </p>
    <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center items-center">
      <Button href="#contact" variant="primary" size="lg">
        Inquire About Seasonal Stock
      </Button>
      <Button href="#" variant="outline-light" size="lg">
        Download Product Specs
      </Button>
    </div>
  </div>

  <!-- Scroll-down indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10">
    <a
      href="#origin"
      class="flex flex-col items-center gap-2 text-cream/70 hover:text-cream transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent rounded"
      aria-label="Scroll to Origin section"
    >
      <span class="text-xs uppercase tracking-widest">Scroll</span>
      <span class="animate-bounce" aria-hidden="true">
        <Icon name="material-symbols:arrow-downward" class="w-6 h-6" />
      </span>
    </a>
  </div>
</section>
