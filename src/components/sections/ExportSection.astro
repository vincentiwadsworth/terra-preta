---
import type { Translations } from "../i18n/ui";
import { Icon } from "astro-icon/components";
import SectionHeading from "../shared/SectionHeading.astro";
import Button from "../shared/Button.astro";

export interface Props {
  locale: string;
  t: Translations;
}
const { locale, t } = Astro.props;

const exportColumns = [
  {
    icon: "check-circle",
    heading: t["export"]["column1Heading"],
    body: t["export"]["column1Body"],
  },
  {
    icon: "local-shipping",
    heading: t["export"]["column2Heading"],
    body: t["export"]["column2Body"],
  },
  {
    icon: "factory",
    heading: t["export"]["column3Heading"],
    body: t["export"]["column3Body"],
  },
];
---

<section id="export" class="section-padding bg-sand scroll-reveal">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <SectionHeading
      title={t["export"]["heading"]}
      subtitle={t["export"]["subheading"]}
    />

    <!-- Three-column layout -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-10 mb-12">
      {exportColumns.map((col) => (
        <div class="text-center">
          <div class="w-14 h-14 mx-auto flex items-center justify-center rounded-full bg-forest-green/10 text-forest-green mb-5">
            <Icon
              name={`material-symbols:${col.icon}`}
              class="w-8 h-8"
              aria-hidden="true"
            />
          </div>
          <h3 class="text-lg font-semibold text-on-background mb-3 text-balance">
            {col.heading}
          </h3>
          <p class="text-on-background/75 leading-relaxed text-balance">
            {col.body}
          </p>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="text-center">
      <Button href="#contact" variant="primary" size="lg" umamiEvent="cta-inquire">
        {t["export"]["ctaButton"]}
      </Button>
    </div>
  </div>
</section>
