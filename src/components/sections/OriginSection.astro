---
import type { Translations } from "../i18n/ui";
import SectionHeading from "../shared/SectionHeading.astro";
import MapEmbed from "../shared/MapEmbed.astro";
import { product } from "../../data/products";

export interface Props {
  locale: string;
  t: Translations;
}
const { locale, t } = Astro.props;
---

<section id="origin" class="section-padding bg-cream scroll-reveal">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <SectionHeading
      title={t["origin"]["heading"]}
      subtitle={t["origin"]["subheading"]}
    />

    <!-- Two-column layout -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Left: Narrative text -->
      <div class="space-y-6">
        <p class="text-lg text-on-background/80 leading-relaxed text-balance">
          {t["origin"]["description"]}
        </p>
        <p class="text-on-background/70 leading-relaxed">
          <Fragment set:html={t["origin"]["paragraph2"]} />
        </p>
      </div>

      <!-- Right: Interactive sourcing map + stats -->
      <div class="relative">
        <MapEmbed />

        <p class="mt-2 text-xs text-on-background/40 text-center">
          {t["origin"]["mapCaption"]}
        </p>

        <!-- Stats overlay -->
        <div class="mt-8 grid grid-cols-3 gap-4 text-center">
          <div>
            <p class="text-3xl md:text-4xl font-bold text-forest-green tabular-nums">
              &lt;100<span class="text-lg">h</span>
            </p>
            <p class="mt-1 text-sm text-on-background/70 text-balance leading-tight">
              {t["origin"]["stat1Label"]}
            </p>
          </div>
          <div>
            <p class="text-3xl md:text-4xl font-bold text-forest-green tabular-nums">
              1,850<span class="text-lg">g</span>
            </p>
            <p class="mt-1 text-sm text-on-background/70 text-balance leading-tight">
              {t["origin"]["stat2Label"]}
            </p>
          </div>
          <div>
            <p class="text-3xl md:text-4xl font-bold text-forest-green tabular-nums">
              {product.oracTotal.toLocaleString("en-US")}
            </p>
            <p class="mt-1 text-sm text-on-background/70 text-balance leading-tight">
              {t["origin"]["stat3Label"]}
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
