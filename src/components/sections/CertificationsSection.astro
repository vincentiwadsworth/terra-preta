---
import type { Translations } from "../i18n/ui";
import { Icon } from "astro-icon/components";
import SectionHeading from "../shared/SectionHeading.astro";
import { certifications } from "../../data/certifications";

export interface Props {
  locale: string;
  t: Translations;
}
const { locale, t } = Astro.props;

const certIcons: Record<string, string> = {
  "USDA NOP Organic": "verified",
  "EU Organic": "eco",
  "Bolivia National Organic": "language",
};

const certColors: Record<string, string> = {
  "USDA NOP Organic": "bg-forest-green/10 text-forest-green",
  "EU Organic": "bg-acai-purple/10 text-acai-purple",
  "Bolivia National Organic": "bg-earth-brown/10 text-earth-brown",
};
---

<section id="certifications" class="section-padding bg-forest-green text-cream scroll-reveal">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <SectionHeading
      inverted
      title={t["certifications"]["heading"]}
      subtitle={t["certifications"]["subheading"]}
    />

    <!-- Certification ownership clarification -->
    <div class="max-w-3xl mx-auto text-center text-sm text-cream/70 mb-8">
      <p>
        {t["certifications"]["note"]}
      </p>
    </div>

    <!-- Three certification cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      {
        certifications.map((cert) => {
          const iconName = certIcons[cert.name] || "verified";
          return (
            <div
              class="bg-cream text-on-background rounded-lg p-6 sm:p-8 flex flex-col border border-cream/20 shadow-md hover:shadow-lg transition-shadow"
            >
              <!-- Icon badge -->
              <div class={`w-12 h-12 flex items-center justify-center rounded-full mb-4 ${certColors[cert.name] || "bg-forest-green/10 text-forest-green"}`}>
                <Icon
                  name={`material-symbols:${iconName}`}
                  class="w-7 h-7"
                  aria-hidden="true"
                />
              </div>

              <!-- Certification name -->
              <h3 class="text-lg font-semibold text-on-background">
                {cert.badgeText}
              </h3>

              <!-- Details -->
              <dl class="mt-4 space-y-2 text-sm flex-1">
                <div>
                  <dt class="text-muted text-xs uppercase tracking-wide">
                    {t["certifications"]["authorityLabel"]}
                  </dt>
                  <dd class="text-on-background/80">{cert.authority}</dd>
                </div>
                <div>
                  <dt class="text-muted text-xs uppercase tracking-wide">{t["certifications"]["idLabel"]}</dt>
                  <dd class="text-on-background/80 font-mono tabular-nums">
                    {cert.id}
                  </dd>
                </div>
                {cert.validUntil && (
                  <div>
                    <dt class="text-muted text-xs uppercase tracking-wide">
                      {t["certifications"]["validUntilLabel"]}
                    </dt>
                    <dd class="text-on-background/80 tabular-nums">
                      {new Date(cert.validUntil).toLocaleDateString("en-GB", {
                        day: "2-digit",
                        month: "2-digit",
                        year: "numeric",
                      })}
                    </dd>
                  </div>
                )}
              </dl>

              <!-- Verify link -->
              {cert.verificationUrl && (
                <a
                  href={cert.verificationUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-forest-green hover:text-forest-green/80 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent rounded min-h-[44px]"
                >
                  {t["certifications"]["verifyLinkPrefix"]} {cert.name}
                  <Icon
                    name="material-symbols:open-in-new"
                    class="w-4 h-4"
                    aria-hidden="true"
                  />
                </a>
              )}
            </div>
          );
        })
      }
    </div>
  </div>
</section>
