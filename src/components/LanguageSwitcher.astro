---
import { getRelativeLocaleUrl } from "astro:i18n";

export interface Props {
  currentLocale: string;
}

const { currentLocale } = Astro.props;

const localeNames: Record<string, string> = {
  en: "English",
  es: "Español",
  fr: "Français",
  de: "Deutsch",
};
---

<nav aria-label="Language switcher" class="flex flex-wrap items-center gap-1">
  {Object.entries(localeNames).map(([code, name]) => (
    <a
      href={getRelativeLocaleUrl(code)}
      aria-label={`Switch to ${name}`}
      aria-current={code === currentLocale ? "page" : undefined}
      class:list={[
        "inline-flex items-center rounded px-2.5 py-1.5 text-sm font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent min-h-[44px] min-w-[44px]",
        code === currentLocale
          ? "bg-cream/15 text-cream"
          : "text-cream/70 hover:bg-cream/10 hover:text-cream",
      ]}
    >
      {name}
    </a>
  ))}
</nav>
