---
const navLinks = [
  { label: "Home", href: "#hero" },
  { label: "Origin", href: "#origin" },
  { label: "Certifications", href: "#certifications" },
  { label: "Product", href: "#product" },
  { label: "Export", href: "#export" },
  { label: "Contact", href: "#contact" },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-forest-green text-cream shadow-md">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6">
    <!-- Logo -->
    <a
      href="#hero"
      class="flex flex-col rounded leading-tight no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      aria-label="Terra Preta — Back to top"
    >
      <span class="text-lg font-bold tracking-tight text-cream">Terra Preta</span>
      <span class="text-xs text-cream/70">Amazonian Superfoods</span>
    </a>

    <!-- Mobile menu: <details>/<summary> — ZERO JavaScript (LP-14) -->
    <details class="group md:hidden">
      <summary
        class="flex list-none cursor-pointer items-center justify-center rounded p-1.5 text-cream transition-colors hover:bg-cream/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent min-h-[44px] min-w-[44px]"
        aria-label="Toggle navigation menu"
      >
        <!-- Hamburger icon (visible when closed) -->
        <svg
          class="h-6 w-6 group-open:hidden"
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <!-- Close icon (visible when open) -->
        <svg
          class="hidden h-6 w-6 group-open:block"
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </summary>
      <nav
        aria-label="Main navigation"
        class="absolute left-0 top-full w-full border-t border-cream/10 bg-forest-green shadow-lg"
      >
        <ul class="flex flex-col px-4 py-3">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="block rounded px-3 py-2.5 text-sm font-medium text-cream/80 transition-colors hover:bg-cream/10 hover:text-cream focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent min-h-[44px] leading-[44px]"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </details>

    <!-- Desktop navigation -->
    <nav
      aria-label="Main navigation"
      class="hidden md:block"
    >
      <ul class="flex gap-0.5">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="inline-flex items-center rounded px-3 py-2 text-sm font-medium text-cream/80 transition-colors hover:bg-cream/10 hover:text-cream focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent min-h-[44px]"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
